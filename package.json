{
  "name": "@akinet/akimcp",
  "version": "3.0.0",
  "mcpName": "io.github.lacvietanh/akimcp",
  "publishConfig": {
    "access": "public"
  },
  "description": "Give Claude on the web (claude.ai) local filesystem/search/shell access over Tailscale Funnel + OAuth 2.1 — whitelist-only shell (unlike Desktop Commander's blocklist), no desktop app or device lock-in required",
  "license": "MIT",
  "type": "module",
  "bin": {
    "akimcp": "bin/akimcp.js"
  },
  "files": [
    "bin",
    "scripts",
    "!scripts/postman/test",
    "public",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lacvietanh/aki-mcp-sv.git"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node ./scripts/start.js",
    "dev": "node ./scripts/start.js --dev",
    "tool-calls": "node ./scripts/tool-calls-report.js",
    "test": "node --test --test-concurrency=1 --test-reporter=spec \"test/*.test.js\" \"scripts/postman/test/*.test.*\""
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "7.3.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "chrome-remote-interface": "^0.33.0",
    "diff": "^8.0.3",
    "zod": "^3.23.8"
  }
}
