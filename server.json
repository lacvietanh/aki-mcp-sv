{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.lacvietanh/akimcp",
  "title": "AKIMCP",
  "description": "Local files, search, git, whitelist-only shell and browser tools for AI chats on your own machine",
  "version": "3.0.0",
  "websiteUrl": "https://akimcp.top",
  "repository": {
    "url": "https://github.com/lacvietanh/aki-mcp-sv",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@akinet/akimcp",
      "version": "3.0.0",
      "runtimeHint": "npx",
      "packageArguments": [
        {
          "type": "positional",
          "value": "--stdio"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
